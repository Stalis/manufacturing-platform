<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="NATS.Net"/>
        <PackageReference Include="Npgsql"/>
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Catalog.Api.Client\Catalog.Api.Client.csproj" />
        <ProjectReference Include="..\Inventory.Contracts\Inventory.Contracts.csproj" />
        <ProjectReference Include="..\Manufacturing.Nats.Contract\Manufacturing.Nats.Contract.csproj" />
        <ProjectReference Include="..\Orders.Core\Orders.Core.csproj"/>
        <ProjectReference Include="..\Producer.Contracts\Producer.Contracts.csproj" />
    </ItemGroup>
</Project>
